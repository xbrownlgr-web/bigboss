# Modèle de configuration pour le serveur de production.
# Copier en ".env" SUR LE SERVEUR, remplir les valeurs, puis lancer : php artisan key:generate
# Ne jamais réutiliser les clés du .env de développement.

APP_NAME="Binho Flash"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Porto-Novo
APP_URL=https://binhoflash.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=binhoflash
DB_USERNAME=binhoflash
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=binhoflash_admin_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=binhoflash_

# E-mails : vérifier le domaine dans Resend, sinon seuls VOS e-mails sont livrés.
RESEND_KEY=
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=noreply@binhoflash.com
MAIL_FROM_NAME="Binho Flash"

# Alertes WhatsApp admin (aussi modifiables depuis Admin > Paramètres)
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# Alerte WhatsApp « nouvelle recharge/retrait » (Cloud API officielle Meta, uniquement ce
# déclencheur). Pas dans Admin > Paramètres : variables d'environnement uniquement.
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
ADMIN_WHATSAPP_NUMBER=

VITE_APP_NAME="${APP_NAME}"
